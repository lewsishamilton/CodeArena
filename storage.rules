rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /certificate-templates/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'admin@codearena.local'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg)');
    }
  }
}
